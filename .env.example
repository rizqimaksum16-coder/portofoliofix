# AI API Keys Configuration (Rule-Based Multi-Provider Fallback)
# Salin file ini menjadi .env.local atau .env dan isi dengan API Key milik Anda.

# Priority 1: Gemini API Primary Key (Google AI Studio)
VITE_GEMINI_API_KEY_1=AIzaSy...

# Priority 2: Gemini API Secondary Key (Google AI Studio Backup Key)
VITE_GEMINI_API_KEY_2=AIzaSy...

# Priority 3: Groq API Backup Key (Groq Cloud Console)
VITE_GROQ_API_KEY=gsk_...
